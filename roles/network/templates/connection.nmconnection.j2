# Managed by Ansible
# Do not edit manually
[connection]
id=ansible-{{ network_interface }}
type=ethernet
interface-name={{ network_interface }}
autoconnect=true
# Negativa a proposito: si NetworkManager ya esta en marcha gestionando esta
# interfaz, no debe cambiar la IP en caliente. En el proximo arranque, al ser
# el unico perfil disponible, si se aplica.
autoconnect-priority=-10

[ethernet]

[ipv4]
method=manual
address1={{ network.address }}/{{ network.prefix }},{{ network.gateway }}
dns={{ network.dns | join(';') }};

[ipv6]
method=disabled

[proxy]
