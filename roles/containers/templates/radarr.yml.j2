services:
  radarr:
    image: linuxserver/radarr:{{ item.version }}
    container_name: radarr
    ports:
      - 7878:{{ item.port }}
    volumes:
      - radarr_data:/config
#      - {{ storage_path }}/torrents:/downloads:Z
      - {{ storage_path }}/media/movies:/storage/Movies:Z
    environment:
      - PUID={{ PUID }}
      - PGID={{ PGID }}
      - TZ={{ timezone }}
    restart: unless-stopped
    networks:
      - {{ traefik_network_name }}
    labels:
{% for label in traefik_labels %}
      - "{{ label }}"
{% endfor %}

volumes:
  radarr_data:

networks:
  {{ traefik_network_name }}:
    external: true
