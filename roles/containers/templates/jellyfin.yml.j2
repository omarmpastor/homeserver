services:
  jellyfin:
    container_name: jellyfin
    image: ghcr.io/hotio/jellyfin:{{ item.version }}
    ports:
      - "8096:{{ item.port }}"
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - UMASK=022
      - WEBUI_PORTS=8096/tcp 
    volumes:
      - jellyfin_data:/config
      - jellyfin_cache:/config/cache
      - {{ storage_path }}/media/movies:/data/movies:Z
      - {{ storage_path }}/media/tvshows:/data/tvshows:Z
      - {{ storage_path }}/media/videos:/data/videos:Z

    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
    group_add:
      - "992"

    networks:
      - {{ traefik_network_name }}
    labels:
{% for label in traefik_labels %}
      - "{{ label }}"
{% endfor %}

volumes:
  jellyfin_data:
  jellyfin_cache:
