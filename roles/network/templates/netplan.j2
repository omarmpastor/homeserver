# Managed by Ansible
# Do not edit manually
#
# El nombre 99- es intencionado: netplan fusiona todos los .yaml en orden
# alfabetico y el ultimo gana, asi que este arquivo prevalece sobre el que
# genera el instalador de Ubuntu.
network:
  version: 2
  renderer: networkd

  ethernets:
    {{ network_interface }}:
      dhcp4: false
      dhcp6: false
      addresses:
        - "{{ network.address }}/{{ network.prefix }}"

      routes:
        - to: default
          via: "{{ network.gateway }}"

{% if network.dns is defined and network.dns | length > 0 %}
      nameservers:
        addresses:
{% for server in network.dns %}
          - "{{ server }}"
{% endfor %}
{% endif %}
