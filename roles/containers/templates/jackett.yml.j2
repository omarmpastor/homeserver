services:
  jackett:
    image: lscr.io/linuxserver/jackett:{{ item.version }}
    container_name: jackett
    environment:
      - PUID={{ PUID }}
      - PGID={{ PGID }}
      - TZ={{ timezone }}
    volumes:
      - jackett_data:/config
    ports:
      - 9117:{{ item.port }}
    restart: unless-stopped
    networks:
      - {{ traefik_network_name }}
    labels:
{% for label in traefik_labels %}
      - "{{ label }}"
{% endfor %}

volumes:
  jackett_data:

networks:
  {{ traefik_network_name }}:
    external: true
