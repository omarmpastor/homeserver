services:
  metube:
    image: ghcr.io/alexta69/metube:{{ item.version }}
    container_name: metube
    restart: unless-stopped
    ports:
      - "8081:{{ item.port }}"
    volumes:
      - {{ storage_path }}/downloads:/downloads:Z
    networks:
      - {{ traefik_network_name }}
    labels:
{% for label in traefik_labels %}
      - "{{ label }}"
{% endfor %}

networks:
  {{ traefik_network_name }}:
    external: true
