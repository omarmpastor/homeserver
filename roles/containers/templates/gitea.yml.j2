services:
  gitea:
    image: docker.gitea.com/gitea:{{ item.version }}
    container_name: gitea
    restart: unless-stopped
    volumes:
      - {{ storage_path }}/gitea_data:/data:Z
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "3000:{{ item.port }}"
      - "2222:2222"
    networks:
      - {{ traefik_network_name }}
    labels:
{% for label in traefik_labels %}
      - "{{ label }}"
{% endfor %}

networks:
  {{ traefik_network_name }}:
    external: true
